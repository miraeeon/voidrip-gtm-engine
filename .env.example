# ─────────────────────────────────────────────────────────────────────────────
#  VOIDRIP GTM Engine configuration. Easiest: run `npm run setup` (it fills this in).
#  The engine starts without provider keys. Fill these only when using the
#  bundled Max and Overloop adapters.
# ─────────────────────────────────────────────────────────────────────────────

# ── Optional bundled-adapter credentials ─────────────────────────────────────
# Max (yourmax.ai): app.yourmax.ai → Settings → API Keys
MAX_API_KEY=
# Overloop (overloop.ai): Settings → API Keys (raw key, no "Bearer")
OVERLOOP_API_KEY=
# Your company's business id in Max (set by `npm run setup` / `gtm init`)
MAX_BUSINESS_ID=

# ── Safety ───────────────────────────────────────────────────────────────────
# locked = nothing can ever be sent (default). live = sending possible, but only via
# explicit `gtm approve` + `gtm launch --confirm SEND`. Scheduled runs never launch.
SEND_MODE=locked
# Prefix of every campaign the bot creates in Overloop (used by `gtm cleanup`)
OVERLOOP_NAME_PREFIX=[GTM-BOT]

# ── Overloop campaign settings (applied to every campaign the bot creates) ─────
OVERLOOP_TIMEZONE=Europe/Brussels
# Days/hours Overloop may send, in OVERLOOP_TIMEZONE
OVERLOOP_SENDING_DAYS=MON,TUE,WED,THU,FRI
OVERLOOP_SEND_START=09:00
OVERLOOP_SEND_END=17:00
# Optional: Overloop user id to send as (see `gtm tool gtm_doctor` → sending addresses)
# OVERLOOP_SENDER_ID=

# ── Daily volume caps ────────────────────────────────────────────────────────
# Leads the agent classifies per day
GTM_DAILY_NEW_LEADS=40
# Sequences finalized per day
GTM_DAILY_SEQUENCES=25
# New Overloop campaigns per day (the rest stay queued for tomorrow)
GTM_DAILY_PUSH_LIMIT=25
# Max pages (100 leads each) pulled from Max per run
GTM_SOURCE_MAX_PAGES=10
# Check every new lead against Overloop history (read-only)
GTM_ENRICH_FROM_OVERLOOP=true

# ── Scheduler / daily runner ─────────────────────────────────────────────────
# `npm run schedule` installs these into Task Scheduler (Windows) or cron (macOS/Linux)
GTM_SCHEDULE_ENABLED=true
GTM_SCHEDULE_TIME=08:00
GTM_SCHEDULE_DAYS=MON,TUE,WED,THU,FRI
# Codex CLI command used by the unattended runner
GTM_AGENT_CMD=codex
# Optional model override. Leave empty to use the model configured in Codex.
GTM_MODEL=
# Kill a run that takes longer than this
GTM_RUN_TIMEOUT_MIN=90
# Extra instructions appended to every daily run (e.g. "focus on tier A only")
GTM_LOOP_NOTE=

# ── Storage & housekeeping ───────────────────────────────────────────────────
# Defaults live inside the repo; override to keep data elsewhere
# GTM_DB_PATH=./data/gtm.db
# GTM_REPORTS_DIR=./reports
# GTM_BACKUP_DIR=./data/backups
# DB snapshots kept (one per daily run; 0 = no backups)
GTM_BACKUP_KEEP=14
# Delete run logs / reports older than this
GTM_LOG_RETENTION_DAYS=30

# ── Advanced ────────────────────────────────────────────────────────────────
# MAX_API_URL=https://api.yourmax.ai/api/v1
# OVERLOOP_API_URL=https://api.overloop.ai/public/v2
# Use a different env file (e.g. one per client): GTM_ENV_FILE=./clients/acme.env
